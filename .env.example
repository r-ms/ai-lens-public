# Optional: Override default port (default: 3000)
# PORT=3000

# Optional: PostgreSQL password (default: ailens)
# POSTGRES_PASSWORD=ailens

# Optional: Analysis interval in seconds (default: 3600)
# ANALYSIS_INTERVAL=3600

# Optional: OpenAI API key for semantic vector search (text search works without it)
# OPENAI_API_KEY=

# Optional: Team definitions shown in the dashboard
# TEAMS_CONFIG={"teams":[{"id":"backend","name":"Backend","members":["alice@acme.com"]}]}

# Optional: Auth0 SSO for team deployments (see README)
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLI_CLIENT_ID=
# AUTH0_AUDIENCE=
# AUTH0_ALLOWED_DOMAIN=
# AI_LENS_ADMIN_SECRET=
# MCP_SERVER_URL=
# CORS_ALLOWED_ORIGINS=
